# Generado por Ansible. No editar a mano: los cambios se pisan en la próxima
# corrida del playbook.
SECRET_KEY={{ coldfront_secret_key | default('SecretToken2026!') }}
DEBUG=False
ALLOWED_HOSTS=*
DATABASE_URL=mysql://{{ coldfront_db_user | default('coldfront') }}:{{ coldfront_db_pass | default('password') }}@{{ hostvars[groups['master'][0]]['ansible_host'] }}:3306/{{ coldfront_db_name | default('coldfront') }}
STATIC_ROOT=/app/static_root

# --- Autenticación LDAP (SSSD/LDAP del master) ---------------------------
# Sin esto ColdFront levanta y muestra la portada, pero no hay forma de
# autenticarse: sólo se puede entrar con un superusuario de Django creado a
# mano. django_auth_ldap crea el usuario de ColdFront en el primer login.
PLUGIN_AUTH_LDAP=true
AUTH_LDAP_SERVER_URI=ldap://{{ hostvars[groups['master'][0]]['ansible_host'] }}:389
AUTH_LDAP_USER_SEARCH_BASE={{ ldap_user_search_base }}
AUTH_LDAP_GROUP_SEARCH_BASE={{ ldap_group_search_base | default('ou=Groups,dc=utn,dc=edu,dc=ar') }}
# El slapd del master no tiene certificado: activar StartTLS sería falsa
# seguridad y rompería el bind.
AUTH_LDAP_START_TLS=False
AUTH_LDAP_BIND_AS_AUTHENTICATING_USER=True
# No hay grupos definidos en el árbol todavía; el mirroring de grupos queda
# apagado hasta que existan.
AUTH_LDAP_MIRROR_GROUPS=False
AUTH_LDAP_GROUP_TYPE=GroupOfNamesType

# Búsqueda de usuarios para_PI_ y para agregar personas a proyectos.
PLUGIN_LDAP_USER_SEARCH=true
LDAP_USER_SEARCH_SERVER_URI=ldap://{{ hostvars[groups['master'][0]]['ansible_host'] }}:389
LDAP_USER_SEARCH_BASE={{ ldap_user_search_base }}
LDAP_USER_SEARCH_USE_SSL=False
LDAP_USER_SEARCH_USE_TLS=False
LDAP_USER_SEARCH_CERT_VALIDATE_MODE=NONE

# --- Integración con Slurm ------------------------------------------------
# El plugin usa sacctmgr para administration de cuentas y queues.
PLUGIN_SLURM=true
SLURM_SACCTMGR_PATH=/usr/bin/sacctmgr
SLURM_NOOP=False

# --- Integración con XDMoD (uso de CPU por proyecto) ---------------------
PLUGIN_XDMOD=true
XDMOD_API_URL=http://{{ ansible_host }}:{{ xdmod_port | default(8085) }}