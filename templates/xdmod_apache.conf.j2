# VirtualHost de Open XDMoD para el nodo de Open OnDemand.
#
# El RPM trae /usr/share/xdmod/templates/apache.conf, pero está pensado para
# HTTPS en el 443 con certificados. Este laboratorio publica en HTTP plano en
# el {{ xdmod_port }}, igual que ColdFront en el {{ coldfront_port }}.
#
# En producción esto debería pasar detrás de TLS: XDMoD expone datos de
# facturación y uso de los usuarios.

Listen {{ xdmod_port }}

<VirtualHost *:{{ xdmod_port }}>
    ServerName {{ xdmod_hostname }}
    DocumentRoot /usr/share/xdmod/html

    <Directory /usr/share/xdmod/html>
        Options FollowSymLinks
        AllowOverride All
        DirectoryIndex index.php

        <IfModule mod_authz_core.c>
            Require all granted
        </IfModule>
    </Directory>

    # XDMoD sirve la API REST desde este subdirectorio.
    <Directory /usr/share/xdmod/html/rest>
        RewriteEngine On
        RewriteRule (.*) index.php [L]
    </Directory>

    # Los reportes se generan con Chromium headless, que necesita estos módulos.
    <IfModule mod_php.c>
        php_admin_value open_basedir /usr/share/xdmod:/etc/xdmod:/var/log/xdmod:/var/spool/cron/xdmod
    </IfModule>

    ErrorLog "|/usr/sbin/rotatelogs -n 5 /var/log/xdmod/apache-error.log 1M"
    CustomLog "|/usr/sbin/rotatelogs -n 5 /var/log/xdmod/apache-access.log 1M" combined
</VirtualHost>
