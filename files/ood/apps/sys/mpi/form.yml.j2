---
# Misma convencion que jupyter/codeserver: solo el cluster declarado.
cluster:
  - "{{ slurm_cluster_name }}"

# Campos del formulario, en orden. Los ids 'mpi_*' son propios de esta app; los
# 'bc_*' los reconoce el dashboard (bc_num_hours trae su propio widget).
form:
  - bc_num_hours
  - mpi_num_nodes
  - mpi_ntasks_per_node
  - mpi_program
  - mpi_args

attributes:
  bc_num_hours:
    label: "Duración maxima"
    value: "01:00:00"
    widget: "text_field"
  mpi_num_nodes:
    label: "Nodos"
    value: "{{ mpi_num_nodes_default }}"
    min: "1"
    max: "{{ mpi_num_nodes_max }}"
    step: "1"
    widget: "number_field"
    help: "Cada nodo aporta 'tasks por nodo' ranks. Con 2 nodos y 1 task/nodo se lanzan 2 ranks."
  mpi_ntasks_per_node:
    label: "Tasks por nodo"
    value: "{{ mpi_ntasks_per_node_default }}"
    min: "1"
    max: "{{ mpi_ntasks_per_node_max }}"
    step: "1"
    widget: "number_field"
    help: "Se pasa a Slurm como --ntasks-per-node. El nodo mas chico del cluster manda: si pide mas de lo que tiene, el job queda PENDING."
  mpi_program:
    label: "Programa MPI (ruta absoluta)"
    value: "/usr/bin/hostname"
    widget: "text_field"
    help: "Binario accesible desde todos los nodos (FS compartido). Por defecto /usr/bin/hostname: con 2 ranks imprime el nombre de cada nodo. Para uno propio, compilalo con mpicc en /shared o en tu home."
  mpi_args:
    label: "Argumentos del programa (opcional)"
    value: ""
    widget: "text_field"
    help: "Se pasan tal cual al programa, despues de la ruta. Sin comillas ni redirecciones."
