---
batch_connect:
  template: "basic"

script:
  native:
<%-
  allowed = /\A(--mem(=|\s+)[^\s]+|--cpus-per-task(=|\s+)\d+|--gres(=|\s+)[^\s]+|--time(=|\s+)[^\s]+|-J(=|\s+)[^\s]+|--partition(=|\s+)[^\s]+)(\s+|\z)/i
  args = bc_slurm_args.to_s.strip
  if args != ""
    tokens = args.split(/[[:space:]]+/)
    bad = tokens.any? { |t| !(t =~ allowed) }
    if bad
      raise "Argumentos Slurm no permitidos. Solo: --mem, --cpus-per-task, --gres, --time, -J, --partition"
    end
  end

  # 'bc_num_hours' es texto libre del formulario y Slurm interpreta un numero
  # SIN unidades como MINUTOS: '-t 1' es "1 minuto", no "1 hora". Con eso la
  # sesion de VS Code moria a los 11 minutos (TimeLimit=00:11:00) y el portal
  # la mostraba como caída sin motivo. Como el campo se llama bc_num_hours, un
  # numero suelto se interpreta como HORAS y se normaliza a HH:MM:SS.
  raw = bc_num_hours.to_s.strip
  duration =
    case raw
    when /\A\d{1,3}\z/             then format("%02d:00:00", raw.to_i)
    when /\A\d{1,3}:\d{2}\z/       then format("%s:00", raw)
    when /\A\d{1,3}:\d{2}:\d{2}\z/ then raw
    else
      raise "Duracion invalida: '#{raw}'. Usa un numero de horas (por ejemplo 2) o HH:MM:SS (por ejemplo 02:00:00)."
    end
-%>
<% if args != "" -%>
<% args.split(/[[:space:]]+/).each do |t| -%>
    - "#SBATCH <%= t %>"
<% end -%>
<% end -%>
    - "--partition"
    - "{{ slurm_partition_name }}"
    - "-N"
    - "1"
    - "--ntasks-per-node"
    - "<%= bc_num_cores.to_i %>"
    - "--mem"
    - "<%= bc_memory.to_i %>M"
    - "-t"
    - "<%= duration %>"