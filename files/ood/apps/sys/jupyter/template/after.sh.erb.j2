# Espera a que el servidor abra el puerto antes de cerrar la sesión.
echo "Waiting for Jupyter server to open port ${port}..."
if wait_until_port_used "${host}:${port}" 600; then
  echo "Jupyter server is listening on ${host}:${port}."
else
  echo "Timed out waiting for the Jupyter server on port ${port}."
  clean_up 1
fi