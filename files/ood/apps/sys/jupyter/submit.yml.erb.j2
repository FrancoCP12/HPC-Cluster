---
# App Batch Connect genérica (template "basic" de ood_core). Los helpers
# find_port / create_passwd / wait_until_port_used los provee el template
# basic: NO hay que instalarlos.
batch_connect:
  template: "basic"
  conn_params:
    - jupyter_api

script:

<%-
  # Validación whitelist de Custom Slurm Args
  allowed = /\A(--mem(=|\s+)[^\s]+|--cpus-per-task(=|\s+)\d+|--gres(=|\s+)[^\s]+|--time(=|\s+)[^\s]+|-J(=|\s+)[^\s]+|--partition(=|\s+)[^\s]+)(\s+|\z)/i
  args = bc_slurm_args.to_s.strip
  if args != ""
    tokens = args.split(/[[:space:]]+/)
    bad = tokens.any? { |t| !(t =~ allowed) }
    if bad
      raise "Argumentos Slurm no permitidos. Solo: --mem, --cpus-per-task, --gres, --time, -J, --partition"
    end
  end
-%>
<% if args != "" -%>
# Custom Slurm arguments (validados)
<% args.split(/[[:space:]]+/).each do |t| -%>
#SBATCH <%= t %>
<% end -%>
<% end -%>
  native:
<%-
  allowed = /\A(--mem(=|\s+)[^\s]+|--cpus-per-task(=|\s+)\d+|--gres(=|\s+)[^\s]+|--time(=|\s+)[^\s]+|-J(=|\s+)[^\s]+|--partition(=|\s+)[^\s]+)(\s+|\z)/i
  args = bc_slurm_args.to_s.strip
  if args != ""
    tokens = args.split(/[[:space:]]+/)
    bad = tokens.any? { |t| !(t =~ allowed) }
    if bad
      raise "Argumentos Slurm no permitidos. Solo: --mem, --cpus-per-task, --gres, --time, -J, --partition"
    end
  end
-%>
<% if args != "" -%>
<% args.split(/[[:space:]]+/).each do |t| -%>
    - "#SBATCH <%= t %>"
<% end -%>
<% end -%>
    # La partición tiene que existir en slurm.conf. Pedir una inexistente hace
    # que sbatch falle al enviar el job y el usuario nunca ve nada.
    - "--partition"
    - "{{ slurm_partition_name }}"
    - "-N"
    - "1"
    - "--ntasks-per-node"
    - "<%= bc_num_cores.to_i %>"
    - "--mem"
    - "<%= bc_memory.to_i %>M"
    - "-t"
    - "<%= bc_num_hours %>"